--- a/src/ui/classic/xcbinputwindow.cpp
+++ b/src/ui/classic/xcbinputwindow.cpp
@@ -340,6 +340,15 @@
         xcb_unmap_window(ui_->connection(), wid_);
         xcb_reparent_window(ui_->connection(), wid_, nextParent ? nextParent : ui_->root(), 0, 0);
         embeddedParent_ = nextParent;
+        if (embeddedParent_) {
+            // Xwayland can replace a client's backing pixmap during an
+            // output move without exposing its still-mapped child. Subscribe
