@@ -375,6 +384,15 @@
         if (expose->window == wid_) {
             repaint();
             return true;
+        }
+        break;
+    }
+    case XCB_CONFIGURE_NOTIFY: {
+        auto *configure = reinterpret_cast<xcb_configure_notify_event_t *>(event);
+        if (embeddedParent_ && configure->window == embeddedParent_ && visible()) {
+            repaint();
+            // This is another client's window; leave the notification
+            // available to the XIM frontend and other registered filters.
         }
         break;
     }
