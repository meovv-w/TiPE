+    const bool hasPreedit = preedit.textLength() > 0 &&
+        preedit.textLength() < WaylandIMServerBase::safeStringLimit;
+    const auto text = hasPreedit ? preedit.toString() : std::string{};
+    if (text != sentPreedit_ && surroundingText().isValid() &&
