diff --git a/gtk3/inputwindow.cpp b/gtk3/inputwindow.cpp
index aeee2b9..0f53c7b 100644
--- a/gtk3/inputwindow.cpp
+++ b/gtk3/inputwindow.cpp
@@ -105,10 +105,20 @@ InputWindow::InputWindow(ClassicUIConfig *config, FcitxGClient *client)
                            highlight, layoutHint, hasPrev, hasNext);
         };
 
-    auto update_im_callback = [](FcitxGClient *, gchar *, gchar *,
+    auto update_im_callback = [](FcitxGClient *, gchar *, gchar *uniqueName,
                                  gchar *langCode, void *user_data) {
         auto that = static_cast<InputWindow *>(user_data);
         that->updateLanguage(langCode);
+#ifdef TIPE_CLIENT_SIDE_PAINTER
+        const bool tipe = g_strcmp0(uniqueName, "tipe") == 0;
+        if (that->tipeInputMethod_ != tipe) {
+            that->tipeInputMethod_ = tipe;
+            that->hoverIndex_ = -1;
+            that->update();
+        }
+#else
+        (void)uniqueName;
+#endif
     };
 
     g_signal_connect(client_.get(), "update-client-side-ui",
@@ -348,9 +358,27 @@ void InputWindow::updateUI(GPtrArray *preedit, int cursor_pos, GPtrArray *auxUp,
     resizeCandidates(candidates->len);
 
     candidateIndex_ = highlight;
+#ifdef TIPE_CLIENT_SIDE_PAINTER
+    tipeUpdate_ = {};
+    for (guint i = 0; i < preedit->len; ++i) {
+        auto *item = static_cast<FcitxGPreeditItem *>(g_ptr_array_index(preedit, i));
+        tipeUpdate_.preedit += item->string;
+    }
+    tipeUpdate_.candidate_cursor = highlight;
+    tipeUpdate_.layout_hint = layoutHint;
+    tipeUpdate_.has_previous = hasPrev;
+    tipeUpdate_.has_next = hasNext;
+    tipeUpdate_.candidates.reserve(candidates->len);
+    if (tipeInputMethod_) {
+        hoverIndex_ = -1;
+    }
+#endif
     for (int i = 0, e = candidates->len; i < e; i++) {
         auto *candidate = static_cast<FcitxGCandidateItem *>(
             g_ptr_array_index(candidates, i));
+#ifdef TIPE_CLIENT_SIDE_PAINTER
+        tipeUpdate_.candidates.emplace_back(candidate->candidate);
+#endif
         setTextToMultilineLayout(labelLayouts_[i], candidate->label);
         setTextToMultilineLayout(candidateLayouts_[i], candidate->candidate);
     }
@@ -385,6 +413,13 @@ void InputWindow::updateLanguage(const char *language) {
 }
 
 std::pair<unsigned int, unsigned int> InputWindow::sizeHint() {
+#ifdef TIPE_CLIENT_SIDE_PAINTER
+    if (tipeInputMethod_) {
+        tipeFrame_ = tipe::client_side::adapt(tipeUpdate_);
+        candidateIndex_ = tipeFrame_.selected;
+        return {tipeFrame_.width, tipeFrame_.height};
+    }
+#endif
     auto *fontDesc = pango_font_description_from_string(config_->font_.data());
     pango_context_set_font_description(context_.get(), fontDesc);
     pango_font_description_free(fontDesc);
@@ -476,6 +511,19 @@ std::pair<unsigned int, unsigned int> InputWindow::sizeHint() {
 }
 
 void InputWindow::paint(cairo_t *cr, unsigned int width, unsigned int height) {
+#ifdef TIPE_CLIENT_SIDE_PAINTER
+    if (tipeInputMethod_) {
+        cairo_save(cr);
+        cairo_set_operator(cr, CAIRO_OPERATOR_SOURCE);
+        cairo_set_source_rgba(cr, 0, 0, 0, 0);
+        cairo_paint(cr);
+        cairo_set_operator(cr, CAIRO_OPERATOR_OVER);
+        tipeFrame_.selected = highlight();
+        tipe::painter::paint(cr, tipeFrame_);
+        cairo_restore(cr);
+        return;
+    }
+#endif
     cairo_set_operator(cr, CAIRO_OPERATOR_SOURCE);
     config_->theme_.paint(cr, config_->theme_.background, width, height);
     const auto &margin = config_->theme_.contentMargin;
@@ -692,6 +740,14 @@ void InputWindow::paint(cairo_t *cr, unsigned int width, unsigned int height) {
 }
 
 void InputWindow::click(int x, int y) {
+#ifdef TIPE_CLIENT_SIDE_PAINTER
+    if (tipeInputMethod_) {
+        if (auto index = tipe::grid::hit_test(tipeFrame_.layout, x, y)) {
+            selectCandidate(static_cast<int>(*index));
+        }
+        return;
+    }
+#endif
     if (hasPrev_ && rectContains(prevRegion_, x, y)) {
         prev();
         return;
@@ -732,6 +788,14 @@ int InputWindow::highlight() const {
 }
 
 bool InputWindow::hover(int x, int y) {
+#ifdef TIPE_CLIENT_SIDE_PAINTER
+    if (tipeInputMethod_) {
+        const int oldHighlight = highlight();
+        const auto index = tipe::grid::hit_test(tipeFrame_.layout, x, y);
+        hoverIndex_ = index ? static_cast<int>(*index) : -1;
+        return oldHighlight != highlight();
+    }
+#endif
     bool needRepaint = false;
 
     bool prevHovered = false;
