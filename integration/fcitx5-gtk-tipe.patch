diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7fe457e..663f676 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -36,6 +36,22 @@ set(CMAKE_C_VISIBILITY_PRESET default)
 
 include(cmake/CompilerSettings.cmake)
 
+# Optional TiPE painter; statically linked into each toolkit module so no
+# process-wide library path or daemon capability override is needed.
+set(TIPE_SOURCE_DIR "" CACHE PATH "TiPE source tree for its client-side painter")
+if (TIPE_SOURCE_DIR)
+    pkg_check_modules(TipePango REQUIRED IMPORTED_TARGET pangocairo)
+    add_library(TipeClientSidePainter STATIC
+        "${TIPE_SOURCE_DIR}/src/candidate_grid.cpp"
+        "${TIPE_SOURCE_DIR}/src/candidate_painter.cpp"
+        "${TIPE_SOURCE_DIR}/src/client_side_candidate_adapter.cpp")
+    target_include_directories(TipeClientSidePainter PUBLIC "${TIPE_SOURCE_DIR}/include")
+    target_compile_features(TipeClientSidePainter PUBLIC cxx_std_20)
+    target_compile_definitions(TipeClientSidePainter PUBLIC TIPE_CLIENT_SIDE_PAINTER=1)
+    target_link_libraries(TipeClientSidePainter PUBLIC PkgConfig::TipePango)
+    set_target_properties(TipeClientSidePainter PROPERTIES POSITION_INDEPENDENT_CODE ON)
+endif()
+
 if (BUILD_ONLY_PLUGIN)
     set(GCLIENT_LIBRARY_TYPE STATIC)
 else()
@@ -94,4 +110,29 @@ if (ENABLE_GTK4_IM_MODULE)
 add_subdirectory(gtk4)
 endif()
 
+option(TIPE_BUILD_TESTS "Build headless TiPE InputWindow integration checks" OFF)
+if (TIPE_BUILD_TESTS AND TARGET TipeClientSidePainter)
+    if (ENABLE_GTK4_IM_MODULE)
+        set(TIPE_TEST_GTK PkgConfig::Gtk4)
+        set(TIPE_TEST_DIR gtk4)
+    elseif (ENABLE_GTK3_IM_MODULE)
+        set(TIPE_TEST_GTK PkgConfig::Gtk3)
+        set(TIPE_TEST_DIR gtk3)
+    else()
+        message(FATAL_ERROR "TiPE integration checks need GTK3 or GTK4")
+    endif()
+    add_executable(tipe-gtk-candidate-smoke
+        "${TIPE_SOURCE_DIR}/integration/gtk-candidate-smoke.cpp"
+        "${TIPE_TEST_DIR}/inputwindow.cpp"
+        "${TIPE_TEST_DIR}/fcitxtheme.cpp"
+        "${TIPE_TEST_DIR}/utils.cpp")
+    target_include_directories(tipe-gtk-candidate-smoke PRIVATE "${TIPE_TEST_DIR}")
+    target_link_libraries(tipe-gtk-candidate-smoke PRIVATE
+        TipeClientSidePainter Fcitx5::GClient ${TIPE_TEST_GTK} PkgConfig::GioUnix2)
+    set_property(TARGET tipe-gtk-candidate-smoke APPEND_STRING PROPERTY LINK_FLAGS
+        " -Wl,--wrap=fcitx_g_client_select_candidate")
+    enable_testing()
+    add_test(NAME tipe-gtk-candidate-smoke COMMAND tipe-gtk-candidate-smoke)
+endif()
+
 feature_summary(WHAT ALL FATAL_ON_MISSING_REQUIRED_PACKAGES)
