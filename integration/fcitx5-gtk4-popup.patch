+// A reactive xdg_popup may remain constrained to its previous output when
+// its parent crosses monitors. Recreate only the popup on authoritative GDK
+// monitor/scale notifications; the composition and parent stay intact.
+void Gtk4InputWindow::watchSurface(GdkSurface *surface) {
+    if (parentSurface_.get() == surface) return;
+    if (parentSurface_) {
+        g_signal_handlers_disconnect_by_data(parentSurface_.get(), this);
+    }
+    parentSurface_.reset(surface ? GDK_SURFACE(g_object_ref(surface)) : nullptr);
+    if (!surface) return;
+    auto monitorChanged = +[](GdkSurface *, GdkMonitor *, gpointer data) {
+        static_cast<Gtk4InputWindow *>(data)->scheduleSurfaceChange();
+    };
+    g_signal_connect(surface, "enter-monitor", G_CALLBACK(monitorChanged), this);
+    g_signal_connect(surface, "leave-monitor", G_CALLBACK(monitorChanged), this);
+    g_signal_connect(surface, "notify::scale",
+        G_CALLBACK(+[](GObject *, GParamSpec *, gpointer data) {
+            static_cast<Gtk4InputWindow *>(data)->scheduleSurfaceChange();
+        }), this);
+    g_signal_connect(surface, "notify::scale-factor",
+        G_CALLBACK(+[](GObject *, GParamSpec *, gpointer data) {
+            static_cast<Gtk4InputWindow *>(data)->scheduleSurfaceChange();
+        }), this);
+}
+
+void Gtk4InputWindow::scheduleSurfaceChange() {
+    if (surfaceChangeSource_ || !window_ || !visible()) return;
+    gtk_widget_set_visible(window_.get(), FALSE);
+    surfaceChangeSource_ = g_idle_add_full(G_PRIORITY_DEFAULT_IDLE,
+        +[](gpointer data) -> gboolean {
+            auto *self = static_cast<Gtk4InputWindow *>(data);
+            self->surfaceChangeSource_ = 0;
+            if (!self->window_ || !self->visible()) return G_SOURCE_REMOVE;
+            auto *popup = FCITX_CLIENT_SIDE_POPUP(self->window_.get());
+            popup->inputWindow = nullptr;
+            gtk_widget_set_visible(self->window_.get(), FALSE);
+            fcitx_client_side_popup_set_parent(popup, nullptr);
+            self->window_.reset();
+            self->update();
+            return G_SOURCE_REMOVE;
+        }, this, nullptr);
+}
