+        // filtering, but use exactly the rectangles drawn by the painter.
+        const Rect emptyRegion(0, 0, -1, -1);
+        candidateRegions_.assign(nCandidates_, emptyRegion);
+        const double scale = tipeFrame_.scale_factor;
+        for (const auto &cell : tipeFrame_.layout.cells) {
+            if (cell.candidate_index >= candidateRegions_.size()) {
+                continue;
+            }
+            // Fcitx Rect stores inclusive endpoints, while the shared grid
+            // uses half-open rectangles. Match hit_test even at 1.25x DPI.
+            const int left = std::ceil(cell.rect.x * scale);
+            const int top = std::ceil(cell.rect.y * scale);
+            const int right = std::ceil((cell.rect.x + cell.rect.width) * scale) - 1;
+            const int bottom = std::ceil((cell.rect.y + cell.rect.height) * scale) - 1;
+            candidateRegions_[cell.candidate_index] = Rect(left, top, right, bottom);
+        }
+        prevRegion_ = nextRegion_ = emptyRegion;
+        prevHovered_ = nextHovered_ = false;
+        return {static_cast<unsigned int>(std::ceil(tipeFrame_.width * scale)),
+                static_cast<unsigned int>(std::ceil(tipeFrame_.height * scale))};
+    }
+#endif
