+double ClassicUI::xwaylandPixelScale(int rootWidth, int rootHeight) const {
+#ifdef WAYLAND_FOUND
+    const wayland::OutputInfomation *only = nullptr;
+    for (const auto &[name, ui] : uis_) {
+        auto *wl = dynamic_cast<WaylandUI *>(ui.get());
+        if (!wl) continue;
+        for (const auto &output : wl->display()->getGlobals<wayland::WlOutput>()) {
+            const auto *info = wl->display()->outputInformation(output.get());
+            if (!info || only) return 0;
+            only = info;
+        }
+    }
+    if (only && only->width() == rootWidth && only->height() == rootHeight &&
+        only->scale() >= 1 && only->scale() <= 8)
+        return only->scale();
+#endif
+    return 0;
+}
